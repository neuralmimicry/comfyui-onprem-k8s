FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

# non-interactive, locale & tz
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/London \
    LANG=en_GB.UTF-8 \
    LANGUAGE=en_GB:en \
    LC_ALL=en_GB.UTF-8

WORKDIR /home/workspace

# 1) Install system packages, add PPAs, configure locale & timezone, clean up
RUN /bin/bash -eo pipefail -c "\
    apt-get update && \
    apt-get install -y --no-install-recommends software-properties-common apt-utils && \
    add-apt-repository -y ppa:apt-fast/stable && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      apt-fast \
      apt-transport-https \
      git \
      curl \
      pkg-config \
      locales \
      tzdata \
      mesa-utils \
      libgl1-mesa-dri \
      libgtk2.0-dev \
      libgtkglext1-dev \
      python3.12 \
      python3.12-dev \
      python3.12-venv \
      python3-pip && \
    echo \"en_GB.UTF-8 UTF-8\" > /etc/locale.gen && \
    locale-gen && \
    update-locale LANG=en_GB.UTF-8 && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* \
"

# 2) Make /usr/bin/python point to python3.12
RUN /bin/bash -eo pipefail -c "update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1"

# 3) Set up and activate a venv, upgrade pip & setuptools
ENV VENV_DIR=/root/.venv
ENV PATH=\"$VENV_DIR/bin:$PATH\"
RUN /bin/bash -eo pipefail -c "\
    python -m venv \$VENV_DIR && \
    \$VENV_DIR/bin/pip install --no-cache-dir --upgrade pip setuptools \
"

# 4) Install PyTorch/TorchAudio with CUDA support
RUN /bin/bash -eo pipefail -c "\
    \$VENV_DIR/bin/pip install --no-cache-dir \
      torch==2.6.0 \
      torchvision~=0.21.0 \
      torchaudio~=2.6.0 \
      --extra-index-url https://download.pytorch.org/whl/cu126 \
"

# 5) Application version args
ARG COMFYUI_VERSION
ARG COMFYUI_MANAGER_VERSION

# 6) Clone ComfyUI at the requested version
RUN /bin/bash -eo pipefail -c "\
    git clone https://github.com/comfyanonymous/ComfyUI.git && \
    cd ComfyUI && \
    git checkout \${COMFYUI_VERSION} \
"

# 7) Clone ComfyUI-Manager plugin
RUN /bin/bash -eo pipefail -c "\
    cd ComfyUI/custom_nodes && \
    git clone https://github.com/ltdrdata/ComfyUI-Manager.git && \
    cd ComfyUI-Manager && \
    git checkout \${COMFYUI_MANAGER_VERSION} \
"

# 8) Install Python dependencies
RUN /bin/bash -eo pipefail -c "\
    \$VENV_DIR/bin/pip install --no-cache-dir -r ComfyUI/requirements.txt \
"

# 9) Final environment & entrypoint
ENV PYTHON=python3.12 \
    COMFYUI_PATH=/home/workspace/ComfyUI \
    PATH=\"$PATH:\$COMFYUI_PATH\"

WORKDIR $COMFYUI_PATH
EXPOSE 50000

# Use bash -lc so that $PYTHON expands
CMD ["bash", "-lc", ". $VENV_DIR/bin/activate && $PYTHON main.py --listen 0.0.0.0 --port 50000"]
