ARG BASE_IMAGE
FROM $BASE_IMAGE

ENV DEBIAN_FRONTEND=noninteractive

# Make sure the venv’s bin directory is on PATH
# (so jupyter, pip, etc. are found)
ENV PATH="$VENV_DIR/bin:$PATH"

# tell the jupyter_comfyui_proxy extension how to reach ComfyUI
ENV COMFYUI_PROXY_TARGET="http://127.0.0.1:50000"

# System packages: apt‐fast comes from the base image
RUN apt-get update \
 && apt-fast install --yes --no-install-recommends \
        ca-certificates \
        dnsutils \
        iputils-ping \
        nodejs \
        tini \
        git \
 && rm -rf /var/lib/apt/lists/*

# Copy the Jupyter requirements into the image
COPY requirements-jupyter.txt requirements.txt

# First, force‐reinstall setuptools & packaging (ignoring whatever’s there),
# then install the pinned Jupyter deps, cleaning up afterward.
RUN $VENV_DIR/bin/pip install \
      --no-cache-dir \
      --upgrade \
      --ignore-installed \
        setuptools \
        packaging && \
    $VENV_DIR/bin/pip install \
      --no-cache-dir \
      --upgrade \
      --ignore-installed \
      -r requirements.txt && \
    rm requirements.txt

# configure server-proxy to mount ComfyUI at /ComfyUI
RUN mkdir -p /etc/jupyter/jupyter_server_config.d \
 && cat <<'JSON' > /etc/jupyter/jupyter_server_config.d/20-comfyui-proxy.json
{
  "ServerProxy": {
    "servers": {
      "comfyui": {
        "port": 50000,
        "timeout": 60,
        "absolute_url": true,
        "launcher_entry": {
          "title": "ComfyUI",
          "icon_path": ""
        }
      }
    }
  }
}
JSON

# Copy & install your Jupyter extension
COPY extensions /home/extensions
RUN $VENV_DIR/bin/pip install --no-cache-dir /home/extensions/jupyter_comfyui_proxy/. \
 && rm -rf /home/extensions \
 && $VENV_DIR/bin/jupyter lab build --dev-build=False --minimize=False

WORKDIR /home/user
EXPOSE 8888

# Source the venv activation, then exec tini to reap zombies and forward signals
ENTRYPOINT [ "sh", "-c", ". \"$VENV_DIR/bin/activate\" && exec /usr/bin/tini -- \"$@\"", "--" ]
CMD ["jupyter","lab","--ip","0.0.0.0","--port","8888","--allow-root"]
