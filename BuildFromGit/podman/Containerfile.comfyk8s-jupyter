# Use your previously built base image
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Use bash for RUN steps (so we can rely on pipefail, etc.)
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

# non-interactive apt
ENV DEBIAN_FRONTEND=noninteractive

# 1) system updates & installs in one layer
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        dnsutils \
        iputils-ping \
        tini \
        git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# (venv_dir and PATH are inherited from the base image)
# ENV VENV_DIR=/home/workspace/.venv
# ENV PATH="$VENV_DIR/bin:$PATH"

WORKDIR /home/workspace

# 2) switch to non-root for Python package installs
USER workspace

# Copy and install Jupyter dependencies
COPY BuildFromGit/podman/requirements-jupyter.txt ./requirements-jupyter.txt
RUN $VENV_DIR/bin/pip install --no-cache-dir -r requirements-jupyter.txt

# Copy and install your Jupyter extension
COPY extensions /home/workspace/extensions
RUN $VENV_DIR/bin/pip install --no-cache-dir /home/workspace/extensions/jupyter_comfyui_proxy

# 3) runtime settings
EXPOSE 8888

ENTRYPOINT ["tini", "--"]
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888"]
