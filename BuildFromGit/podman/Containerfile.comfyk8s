FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

# Use bash for RUN steps
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

# non-interactive tzdata and locale
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/London

# install all OS deps, set locale/timezone, clean up in one layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      tzdata \
      locales \
      git \
      curl \
      pkg-config \
      python3.12 \
      python3.12-dev \
      python3.12-venv \
      python3-pip \
      libgl1-mesa-dri \
      libgtkglext1-dev && \
    # locale setup
    echo "en_GB.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen && \
    update-locale LANG=en_GB.UTF-8 && \
    # timezone setup
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    # cleanup
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# set python alternative
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

# virtualenv path
ENV VENV_DIR=/home/workspace/.venv
ENV PATH="$VENV_DIR/bin:$PATH"

WORKDIR /home/workspace

# prepare app files: copy only requirements first
COPY ComfyUI/requirements.txt ./requirements.txt

# create venv & install Python deps
RUN python -m venv $VENV_DIR && \
    $VENV_DIR/bin/pip install --no-cache-dir --upgrade pip setuptools && \
    $VENV_DIR/bin/pip install --no-cache-dir -r requirements.txt

# now fetch the app code
ARG COMFYUI_VERSION
ARG COMFYUI_MANAGER_VERSION
RUN git clone https://github.com/comfyanonymous/ComfyUI.git && \
    cd ComfyUI && \
    git checkout ${COMFYUI_VERSION} && \
    cd custom_nodes && \
    git clone https://github.com/ltdrdata/ComfyUI-Manager.git && \
    cd ComfyUI-Manager && \
    git checkout ${COMFYUI_MANAGER_VERSION}

# switch to non-root
RUN useradd --create-home workspace && \
    chown -R workspace:workspace /home/workspace
USER workspace

WORKDIR /home/workspace/ComfyUI
EXPOSE 50000

ENTRYPOINT ["/home/workspace/.venv/bin/python", "main.py", "--listen", "0.0.0.0", "--port", "50000"]
