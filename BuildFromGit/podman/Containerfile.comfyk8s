FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

# Use bash in all RUN steps so we can safely use bash-isms
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

# non-interactive installs, timezone & locale
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/London \
    LANG=en_GB.UTF-8 \
    LANGUAGE=en_GB:en \
    LC_ALL=en_GB.UTF-8

WORKDIR /home/workspace

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      software-properties-common \
      apt-utils && \
    add-apt-repository -y ppa:apt-fast/stable && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      apt-fast \
      apt-transport-https \
      git \
      curl \
      pkg-config \
      locales \
      tzdata \
      mesa-utils \
      libgl1-mesa-dri \
      libgtk2.0-dev \
      libgtkglext1-dev \
      python3.12 \
      python3.12-dev \
      python3.12-venv \
      python3-pip && \
    echo "en_GB.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen && \
    update-locale LANG=en_GB.UTF-8 && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Make 'python' point at python3.12
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

# Virtualenv setup
ENV VENV_DIR=/root/.venv
ENV PATH="$VENV_DIR/bin:$PATH"

RUN python -m venv $VENV_DIR && \
    $VENV_DIR/bin/pip install --no-cache-dir --upgrade pip setuptools

# torch + xformers
RUN $VENV_DIR/bin/pip install --no-cache-dir \
      torch==2.6.0 \
      torchvision~=0.21.0 \
      torchaudio~=2.6.0 \
      --extra-index-url https://download.pytorch.org/whl/cu126

# These ARGs no longer have empty '='s
ARG COMFYUI_VERSION
ARG COMFYUI_MANAGER_VERSION

# Clone ComfyUI at the specified version
RUN git clone https://github.com/comfyanonymous/ComfyUI.git && \
    cd ComfyUI && \
    git checkout ${COMFYUI_VERSION}

# Clone the Manager plugin
RUN cd ComfyUI/custom_nodes && \
    git clone https://github.com/ltdrdata/ComfyUI-Manager.git && \
    cd ComfyUI-Manager && \
    git checkout ${COMFYUI_MANAGER_VERSION}

# Install Python deps from requirements.txt
RUN $VENV_DIR/bin/pip install --no-cache-dir -r ComfyUI/requirements.txt

# Runtime environment
ENV PYTHON=python3.12
ENV COMFYUI_PATH=/home/workspace/ComfyUI
ENV PATH="$PATH:$COMFYUI_PATH"

WORKDIR $COMFYUI_PATH
EXPOSE 50000

# Exec form won’t expand $PYTHON, so we wrap in bash -lc
CMD ["bash", "-lc", "$PYTHON main.py --listen 0.0.0.0 --port 50000"]
